      </div>
      <pre><code class="language-cpp">#include &lt;Wire.h&gt;
#include &lt;Adafruit_GFX.h&gt;
#include &lt;Adafruit_SSD1306.h&gt;
#include &lt;DHT.h&gt;

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &amp;Wire, OLED_RESET);

#define GAS_PIN A0
#define DHT_PIN 2
#define FIRE_PIN 3
#define SOS_PIN 4

#define SAFE_LED 5
#define WARNING_LED 6
#define DANGER_LED 7
#define FAN_LED 8

#define RELAY_PIN 9

#define DHT_TYPE DHT11
DHT dht(DHT_PIN, DHT_TYPE);

int gasWarning = 350;
int gasDanger = 600;

float tempWarning = 35.0;
float tempDanger = 45.0;

void setup() {

  Serial.begin(9600);

  pinMode(FIRE_PIN, INPUT);
  pinMode(SOS_PIN, INPUT_PULLUP);

  pinMode(SAFE_LED, OUTPUT);
  pinMode(WARNING_LED, OUTPUT);
  pinMode(DANGER_LED, OUTPUT);
  pinMode(FAN_LED, OUTPUT);

  pinMode(RELAY_PIN, OUTPUT);

  digitalWrite(RELAY_PIN, LOW);

  dht.begin();

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (1);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);
  display.setCursor(15, 10);
  display.println("SMART UNDERGROUND");

  display.setCursor(25, 25);
  display.println("MINE SAFETY");

  display.setCursor(35, 45);
  display.println("SYSTEM");

  display.display();

  delay(2500);
}

void loop() {

  int gasValue = analogRead(GAS_PIN);

  float temperature = dht.readTemperature();

  bool fireDetected = (digitalRead(FIRE_PIN) == LOW);

  bool sosPressed = (digitalRead(SOS_PIN) == LOW);

  bool danger = false;
  bool warning = false;

  // DANGER CONDITIONS

  if (gasValue &gt;= gasDanger ||
      temperature &gt;= tempDanger ||
      fireDetected ||
      sosPressed) {

    danger = true;

  }

  // WARNING CONDITIONS

  else if (gasValue &gt;= gasWarning ||
           temperature &gt;= tempWarning) {

    warning = true;

  }

  // OUTPUT CONTROL

  if (danger) {

    digitalWrite(SAFE_LED, LOW);
    digitalWrite(WARNING_LED, LOW);
    digitalWrite(DANGER_LED, HIGH);

    digitalWrite(RELAY_PIN, HIGH);
    digitalWrite(FAN_LED, HIGH);

  }

  else if (warning) {

    digitalWrite(SAFE_LED, LOW);
    digitalWrite(WARNING_LED, HIGH);
    digitalWrite(DANGER_LED, LOW);

    digitalWrite(RELAY_PIN, HIGH);
    digitalWrite(FAN_LED, HIGH);

  }

  else {

    digitalWrite(SAFE_LED, HIGH);
    digitalWrite(WARNING_LED, LOW);
    digitalWrite(DANGER_LED, LOW);

    digitalWrite(RELAY_PIN, LOW);
    digitalWrite(FAN_LED, LOW);

  }

  // OLED

  display.clearDisplay();

  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("MINE SAFETY SYSTEM");

  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setCursor(0, 16);
  display.print("Gas : ");
  display.println(gasValue);

  display.setCursor(0, 27);
  display.print("Temp: ");

  if (isnan(temperature)) {
    display.println("ERROR");
  } else {
    display.print(temperature, 1);
    display.println(" C");
  }

  display.setCursor(0, 38);
  display.print("Fire: ");

  if (fireDetected)
    display.println("DETECTED");
  else
    display.println("SAFE");

  display.setCursor(0, 49);

  if (sosPressed) {
    display.println("SOS! EMERGENCY");
  }
  else if (danger) {
    display.println("DANGER! EVACUATE");
  }
  else if (warning) {
    display.println("WARNING! FAN ON");
  }
  else {
    display.println("STATUS: SAFE");
  }

  display.display();

  delay(500);
