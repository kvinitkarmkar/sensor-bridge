<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Underground Mines Safety System</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
<style>
  :root{
    --bg:#FBFAF7;
    --paper:#FFFFFF;
    --paper-2:#F5F3EE;
    --ink:#1A2230;
    --muted:#6B7280;
    --hairline:#E7E3DA;
    --gold:#B8862F;
    --gold-deep:#8C6420;
    --navy:#16283F;
    --danger:#C1443A;
    --warn:#C9862F;
    --safe:#2F8F5B;
    --shadow: 0 20px 45px -25px rgba(26,34,48,0.28);
    --code-bg:#282c34;
    --code-border:#3a3f4b;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    letter-spacing:0.01em;
    margin:0;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{
    max-width:1120px;
    margin:0 auto;
    padding:0 24px;
  }
  @media (min-width:640px){ .wrap{padding:0 40px;} }
  .hazard-rule{
    height:5px;
    background:repeating-linear-gradient(135deg,var(--gold) 0 16px, var(--navy) 16px 32px);
    opacity:0.9;
  }

  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(251,250,247,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--hairline);
  }
  nav .wrap{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 24px;
  }
  .brand{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:19px;
    display:flex; align-items:center; gap:9px;
    color:var(--navy);
    text-decoration:none;
  }
  .brand .dot{width:9px;height:9px;border-radius:50%;background:var(--safe);}
  .navlinks{display:flex; gap:30px; font-size:15px; color:var(--muted);}
  .navlinks a{text-decoration:none; transition:color .2s;}
  .navlinks a:hover{color:var(--gold-deep);}
  .burger{
    display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:6px;
  }
  .burger span{width:22px; height:2px; background:var(--navy); display:block;}
  #navtoggle{display:none;}
  .mobile-menu{
    display:none;
    flex-direction:column;
    background:var(--paper);
    border-bottom:1px solid var(--hairline);
    padding:8px 24px 18px;
  }
  .mobile-menu a{
    text-decoration:none; color:var(--ink); font-size:16px;
    padding:12px 0; border-bottom:1px solid var(--hairline);
  }
  .mobile-menu a:last-child{border-bottom:none;}
  #navtoggle:checked ~ .mobile-menu{display:flex;}
  @media (max-width:800px){
    .navlinks{display:none;}
    .burger{display:flex;}
  }

  .hero{
    position:relative;
    padding:56px 0 48px;
    background:
      radial-gradient(900px 420px at 88% -14%, rgba(184,134,47,0.10), transparent 60%),
      linear-gradient(180deg, var(--paper) 0%, var(--bg) 90%);
    border-bottom:1px solid var(--hairline);
    overflow:hidden;
  }
  @media (min-width:900px){ .hero{padding:92px 0 72px;} }
  .hero .wrap{
    display:grid;
    grid-template-columns:1fr;
    gap:38px;
    align-items:center;
  }
  .kicker{
    font-size:12.5px; letter-spacing:0.14em; color:var(--gold-deep);
    font-weight:700; text-transform:uppercase;
    margin-bottom:16px;
  }
  .hero h1{
    font-size:clamp(36px,8vw,60px);
    line-height:1.03;
    color:var(--navy);
  }
  .hero p.lead{
    font-size:17px; color:var(--muted); max-width:60ch;
    margin-top:20px;
  }
  .hero-photo{
    margin-top:30px;
    border-radius:12px;
    overflow:hidden;
    border:1px solid var(--hairline);
    box-shadow:var(--shadow);
    max-width:640px;
  }
  .hero-photo img{width:100%; height:auto; display:block;}

  section{padding:60px 0;}
  @media (min-width:900px){ section{padding:92px 0;} }
  .section-head{max-width:640px; margin-bottom:38px;}
  @media (min-width:900px){ .section-head{margin-bottom:48px;} }
  .section-tag{color:var(--gold-deep); font-size:12.5px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; margin-bottom:12px;}
  .section-head h2{font-size:clamp(26px,5.5vw,40px); color:var(--navy);}
  .section-head p{color:var(--muted); margin-top:14px; font-size:16px;}

  .overview-grid{display:grid; grid-template-columns:1fr; gap:22px;}
  @media (min-width:760px){.overview-grid{grid-template-columns:1fr 1fr; gap:28px;}}
  .card{
    background:var(--paper);
    border:1px solid var(--hairline);
    border-top:3px solid var(--gold);
    padding:26px 26px;
    border-radius:10px;
    box-shadow:var(--shadow);
  }
  .card.problem{border-top-color:var(--danger);}
  .card.solution{border-top-color:var(--safe);}
  .card h3{font-size:21px; color:var(--navy); margin-bottom:12px;}
  .card p{color:var(--muted); font-size:15px;}

  .stages{display:grid; grid-template-columns:1fr; gap:16px;}
  @media (min-width:760px){.stages{grid-template-columns:repeat(3,1fr); gap:0; border:1px solid var(--hairline); border-radius:12px; overflow:hidden; background:var(--paper); box-shadow:var(--shadow);}}
  .stage{padding:26px 24px; background:var(--paper); border:1px solid var(--hairline); border-radius:10px;}
  @media (min-width:760px){ .stage{border:none; border-right:1px solid var(--hairline); border-radius:0;} .stage:last-child{border-right:none;} }
  .stage .stage-tag{font-size:11.5px; letter-spacing:0.1em; text-transform:uppercase; font-weight:700; margin-bottom:14px; display:inline-block; padding:3px 10px; border-radius:20px;}
  .stage.s1 .stage-tag{color:var(--safe); background:rgba(47,143,91,0.1);}
  .stage.s2 .stage-tag{color:var(--warn); background:rgba(201,134,47,0.12);}
  .stage.s3 .stage-tag{color:var(--danger); background:rgba(193,68,58,0.1);}
  .stage h4{font-size:20px; color:var(--navy); margin-bottom:10px;}
  .stage p{color:var(--muted); font-size:14px; margin-bottom:14px;}
  .stage ul{margin:0; padding-left:18px; color:var(--muted); font-size:13.5px;}
  .stage li{margin-bottom:4px;}

 .comp-scroll{
  overflow:hidden;
  padding:6px 0 18px;
}

.comp-track{
  display:flex;
  gap:18px;
  width:max-content;
  animation:comp-marquee 32s linear infinite;
}

.comp-scroll:hover .comp-track,
.comp-scroll:focus-within .comp-track{
  animation-play-state:paused;
}

@keyframes comp-marquee{
  from{
    transform:translateX(0);
  }
  to{
    transform:translateX(-50%);
  }
}
  .comp{
    flex:0 0 250px;
    background:var(--paper);
    border:1px solid var(--hairline);
    border-radius:12px;
    overflow:hidden;
    box-shadow:var(--shadow);
    display:flex;
    flex-direction:column;
  }
  .comp .img-wrap{
    width:100%;
    aspect-ratio:4/3;
    background:#fff;
    border-bottom:1px solid var(--hairline);
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
  }
  .comp .img-wrap img{
    width:100%; height:100%; object-fit:contain; padding:16px;
  }
  .comp .body{padding:18px 18px 20px;}
  .comp .k{font-size:11.5px; color:var(--gold-deep); letter-spacing:0.06em; margin-bottom:6px; text-transform:uppercase; font-weight:700;}
  .comp .v{font-size:18px; color:var(--navy); font-family:'Barlow Condensed',sans-serif; font-weight:700;}
  .comp .d{font-size:12.5px; color:var(--muted); margin-top:5px;}
  .comp .usage{font-size:13px; color:var(--ink); margin-top:12px; padding-top:12px; border-top:1px dashed var(--hairline); line-height:1.55;}
  .scroll-hint{font-size:12.5px; color:var(--muted); margin-top:2px; display:flex; align-items:center; gap:8px;}
  .scroll-hint svg{flex:none;}

  .team-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px;}
  @media (min-width:600px){.team-grid{grid-template-columns:repeat(3,1fr);}}
  @media (min-width:900px){.team-grid{grid-template-columns:repeat(5,1fr); gap:20px;}}
  .member{background:var(--paper); border:1px solid var(--hairline); border-radius:12px; overflow:hidden; text-align:center; box-shadow:var(--shadow);}
  .member .photo{aspect-ratio:1/1; overflow:hidden; background:var(--navy);}
  .member .photo img{width:100%; height:100%; object-fit:cover;}
  .member .info{padding:12px 8px 16px;}
  .member .info h4{font-size:15.5px; color:var(--navy); font-weight:600; font-family:'Inter',sans-serif;}
  .member .info span{font-size:12px; color:var(--muted);}
  .team-note{margin-top:20px; font-size:13px; color:var(--muted); font-style:italic;}

  .code-wrap{background:var(--code-bg); border:1px solid var(--code-border); border-radius:10px; overflow:hidden; box-shadow:var(--shadow);}
  .code-top{
    display:flex; align-items:center; justify-content:space-between;
    background:#21252b; padding:10px 16px; border-bottom:1px solid var(--code-border);
  }
  .code-top .fname{font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:#8b96a5;}
  .dots{display:flex; gap:7px;}
  .dots span{width:9px; height:9px; border-radius:50%; background:var(--code-border);}
  pre{margin:0; padding:16px; overflow:auto; max-height:640px; font-size:12.5px; line-height:1.65; background:transparent !important;}
  @media (min-width:760px){ pre{padding:20px 22px; font-size:13.5px;} }
  code{font-family:'IBM Plex Mono',monospace !important; background:transparent !important;}
  pre code.hljs{padding:0 !important; background:transparent !important;}

  footer{border-top:1px solid var(--hairline); padding:32px 0; background:var(--paper);}
  footer .wrap{display:flex; flex-direction:column; gap:8px;}
  @media (min-width:640px){ footer .wrap{flex-direction:row; justify-content:space-between; align-items:center;} }
  footer .f-brand{font-family:'Barlow Condensed',sans-serif; font-weight:700; color:var(--navy); font-size:17px;}
  footer .f-note{color:var(--muted); font-size:13px;}

  .visitor-count{
  display:inline-flex;
  align-items:center;
  gap:5px;
  color:var(--muted);
  font-size:13px;
  white-space:nowrap;
}

.visitor-count strong{
  color:var(--navy);
  font-family:'IBM Plex Mono',monospace;
  font-weight:600;
}

  /* =========================================================
     LIVE DEMO (INTERACTIVE)
     - outer section background matches the rest of the site
     - demo card keeps its original dark console styling
     - only the thick black bezel border around the OLED is removed
  ========================================================= */

  .sim-section{
    background:var(--paper-2);
    color:var(--ink);
    border-top:1px solid var(--hairline);
    border-bottom:1px solid var(--hairline);
  }

  .sim-section .section-tag{color:var(--gold-deep);}
  .sim-section .section-head h2{color:var(--navy);}
  .sim-section .section-head p{color:var(--muted);}

  .simulator{max-width:760px; margin:0 auto;}

  .demo-card{
    background:#14243a;
    border:1px solid #31465f;
    border-radius:20px;
    box-shadow:0 28px 65px -35px rgba(0,0,0,.85);
    overflow:hidden;
  }

  /* OLED */
  .oled-area{padding:20px 20px 18px;}
  .oled-bezel-label{
    text-align:center;
    color:#71849a;
    font:700 10px/1 'IBM Plex Mono', monospace;
    letter-spacing:.22em;
    text-transform:uppercase;
    margin:2px 0 10px;
  }

  .digital-oled{
    position:relative;
    background:#5ee879;
    border:1px solid #2d425c;
    border-radius:8px;
    padding:20px 24px;
    color:#071b0c;
    font:700 14px/1.5 'IBM Plex Mono', monospace;
    letter-spacing:.04em;
    box-shadow:0 16px 38px -20px rgba(0,0,0,.95), inset 0 0 30px rgba(255,255,255,.16);
    min-height:225px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    overflow:hidden;
    transition:background .25s ease, color .25s ease, box-shadow .25s ease;
  }

  .digital-oled.safe{background:#5ee879; color:#071b0c;}
  .digital-oled.warning{
    background:#f4b84f; color:#351c00;
    box-shadow:0 0 28px rgba(244,184,79,.38), inset 0 0 30px rgba(255,255,255,.12);
    animation:oledWarningBlink 1.15s ease-in-out infinite;
  }
  .digital-oled.danger{
    background:#ef5a4f; color:#3c0704;
    box-shadow:0 0 38px rgba(239,90,79,.5), inset 0 0 30px rgba(255,255,255,.12);
    animation:oledDangerBlink .55s ease-in-out infinite;
  }

  @keyframes oledWarningBlink{0%,100%{filter:brightness(1);} 50%{filter:brightness(.72);}}
  @keyframes oledDangerBlink{0%,100%{filter:brightness(1);} 50%{filter:brightness(.62);}}

  .digital-oled:before{
    content:"";
    position:absolute; inset:0;
    background:repeating-linear-gradient(0deg, rgba(0,0,0,.035) 0, rgba(0,0,0,.035) 1px, transparent 1px, transparent 4px);
    pointer-events:none; opacity:.7;
  }
  .digital-oled:after{
    content:""; position:absolute; inset:8px;
    border:1px solid rgba(0,0,0,.12);
    pointer-events:none;
  }

  .oled-title{
    display:flex; justify-content:space-between;
    color:inherit; font-weight:900;
    padding-bottom:10px; margin-bottom:10px;
    border-bottom:2px dashed rgba(7,27,12,.45);
    gap:10px;
  }
  .oled-line{display:flex; justify-content:space-between; padding:4px 0; gap:15px;}
  .oled-status{
    margin-top:9px; padding-top:9px;
    border-top:2px dashed rgba(7,27,12,.45);
    font-weight:900; color:inherit;
  }
  .oled-status.safe{color:#073d14;}
  .oled-status.warning{color:#6b3d00;}
  .oled-status.danger{color:#6e0904;}

  /* CONTROLS */
  .controls-area{border-top:1px solid #2b3d54; padding:20px;}
  .control-top{display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:10px;}
  .control-top h3{color:#fff; font-size:22px;}
  .demo-badge{
    font:600 11px 'IBM Plex Mono', monospace;
    letter-spacing:.08em; text-transform:uppercase;
    padding:7px 11px; border:1px solid #405874;
    border-radius:999px; color:#9fb0c4;
  }

  .sensor-control{padding:16px 0; border-top:1px solid #2b3d54;}
  .sensor-control:first-of-type{border-top:none;}
  .sensor-label{display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:9px;}
  .sensor-label span:first-child{color:#dfe7ef; font-size:16px; font-weight:600;}
  .sensor-value{font:700 15px 'IBM Plex Mono', monospace; color:#fff; white-space:nowrap;}

  .range-row{width:100%;}
  .range-row input[type=range]{
    -webkit-appearance:none; appearance:none;
    width:100%; height:9px; border-radius:999px;
    background:linear-gradient(90deg, #3fa66b 0%, #3fa66b 28%, #d7ae5b 28%, #d7ae5b 58%, #d25a4e 58%, #d25a4e 100%);
    outline:none; cursor:pointer;
    box-shadow:inset 0 1px 3px rgba(0,0,0,.45);
  }
  #tempSlider{background:linear-gradient(90deg, #3fa66b 0%, #3fa66b 37.5%, #d7ae5b 37.5%, #d7ae5b 62.5%, #d25a4e 62.5%, #d25a4e 100%);}
  #gasSlider{background:linear-gradient(90deg, #3fa66b 0%, #3fa66b 34.2%, #d7ae5b 34.2%, #d7ae5b 58.7%, #d25a4e 58.7%, #d25a4e 100%);}

  .range-row input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none; width:21px; height:21px; border-radius:50%;
    background:#f5f7f9; border:4px solid #d7ae5b;
    box-shadow:0 3px 12px rgba(0,0,0,.5), 0 0 0 4px rgba(215,174,91,.12);
  }
  .range-row input[type=range]::-moz-range-thumb{
    width:15px; height:15px; border-radius:50%;
    background:#f5f7f9; border:4px solid #d7ae5b;
    box-shadow:0 3px 12px rgba(0,0,0,.5);
  }

  .range-row input.safe::-webkit-slider-thumb{border-color:#4cae74;}
  .range-row input.warning::-webkit-slider-thumb{border-color:#d7ae5b;}
  .range-row input.danger::-webkit-slider-thumb{border-color:#d25a4e;}
  .range-row input.safe::-moz-range-thumb{border-color:#4cae74;}
  .range-row input.warning::-moz-range-thumb{border-color:#d7ae5b;}
  .range-row input.danger::-moz-range-thumb{border-color:#d25a4e;}

  .range-minmax{display:grid; grid-template-columns:repeat(4,1fr); color:#78899e; font-size:10.5px; margin-top:6px;}
  .range-minmax span:nth-child(2), .range-minmax span:nth-child(3){text-align:center;}
  .range-minmax span:last-child{text-align:right;}

  /* BUTTONS */
  .sim-toggle{
    width:100%; border:1px solid #40546b; background:#1a2c44;
    color:#dce5ef; padding:11px 13px; border-radius:10px;
    cursor:pointer; font-weight:700; transition:.2s;
  }
  .sim-toggle:hover{border-color:#617892;}
  .sim-toggle.active{
    background:#6b2521; border-color:#a94239; color:#fff;
    box-shadow:0 0 18px rgba(193,68,58,.18);
  }

  .sos-btn{
    width:100%; padding:13px; border:1px solid #a94239;
    background:#341a1b; color:#ffb6af;
    border-radius:10px; font-weight:800; letter-spacing:.03em;
    cursor:pointer; transition:.2s;
  }
  .sos-btn:hover{background:#482021;}
  .sos-btn.active{
    background:#b83b33; color:#fff;
    box-shadow:0 0 24px rgba(193,68,58,.35);
    animation:sosPulse .8s ease-in-out infinite;
  }
  @keyframes sosPulse{50%{transform:scale(1.015);}}

  .reset-btn{
    width:100%; margin-top:10px; padding:10px;
    border:1px solid #40546b; background:transparent;
    color:#aebaca; border-radius:9px; cursor:pointer; transition:.2s;
  }
  .reset-btn:hover{background:#1a2c44; color:#fff;}

  /* SYSTEM VISUAL */
  .system-area{border-top:1px solid #2b3d54; padding:18px 20px 20px;}
  .system-visual{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .node{
    padding:12px; background:#182b43; border:1px solid #2d425c;
    border-radius:11px; transition:border-color .2s, box-shadow .2s;
  }
  .node .node-head{
    display:flex; justify-content:space-between; align-items:center;
    gap:8px; font-size:10px; color:#93a5b9;
    text-transform:uppercase; letter-spacing:.06em;
  }
  .node .node-value{margin-top:6px; font:700 13px 'IBM Plex Mono', monospace; color:#fff;}
  .node.active{border-color:#4c9a6c;}
  .node.warning{border-color:#9b7330; box-shadow:0 0 0 1px rgba(201,134,47,.08) inset;}
  .node.danger{border-color:#a94239; box-shadow:0 0 0 1px rgba(193,68,58,.1) inset;}

  /* FAN */
  .fan-box{grid-column:span 2; display:flex; align-items:center; gap:14px;}
  .fan{
    width:62px; height:62px; flex:0 0 62px;
    border:5px solid #6c7e92; border-radius:50%;
    position:relative; background:#0b1726;
    display:grid; place-items:center; overflow:hidden;
  }
  .fan-hub{width:13px; height:13px; border-radius:50%; background:#aebaca; position:absolute; z-index:2;}
  .blades{width:48px; height:48px; position:relative;}
  .blade{
    position:absolute; left:20px; top:2px; width:8px; height:23px;
    border-radius:8px 8px 4px 4px; background:#91a0b0;
    transform-origin:50% 22px;
  }
  .blade:nth-child(2){transform:rotate(90deg);}
  .blade:nth-child(3){transform:rotate(180deg);}
  .blade:nth-child(4){transform:rotate(270deg);}
  /* blade rotation is applied directly via JS (gradual accel/decel), not a fixed-speed CSS animation */
  .blades{transition:none;}

  .airflow{opacity:0; color:#78b8d8; font-size:18px; letter-spacing:4px; transition:opacity .3s ease;}
  .fan-box.on .airflow{animation:flow .8s ease-in-out infinite alternate;}
  @keyframes flow{to{transform:translateX(7px);}}

  .sim-legend{font-size:10.5px; color:#8192a7; line-height:1.5; margin-top:12px;}

  @media (max-width:520px){
    .sim-section{padding-top:45px; padding-bottom:45px;}
    .simulator{width:100%;}
    .demo-card{border-radius:16px;}
    .oled-area{padding:15px;}
    .digital-oled{padding:15px 13px; font-size:11px; min-height:205px; letter-spacing:.025em;}
    .oled-title{font-size:10px; flex-wrap:wrap; gap:5px;}
    .oled-line{padding:3px 0;}
    .controls-area{padding:15px;}
    .control-top h3{font-size:20px;}
    .sensor-control{padding:13px 0;}
    .sensor-label span:first-child{font-size:15px;}
