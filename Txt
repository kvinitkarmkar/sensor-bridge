<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>hljs.highlightAll();</script>

<script>
(() => {
  "use strict";

  const $ = id => document.getElementById(id);

  const state = { temp:29.4, gas:212, fire:false, sos:false };

  /* =========================================================
     FAN PHYSICS
     - fan idles at rest (0 deg/sec)
     - warning -> eases up to a medium cruising speed
     - danger  -> eases up to full speed
     - turning off (or dropping a stage) eases back down instead
       of stopping/jumping instantly, like a real fan spinning down
  ========================================================= */

  const FAN_SPEED = { safe:0, warning:150, danger:360 }; // degrees per second at cruise
  const FAN_TAU = 0.9; // seconds — how gradually speed approaches its target

  let fanAngle = 0;
  let fanSpeed = 0;
  let fanTargetSpeed = 0;
  let fanLastTime = null;

  const fanBladesEl = document.querySelector('#fanGraphic .blades');
  const fanAirflowEl = document.querySelector('#fanNode .airflow');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function fanLoop(timestamp){
    if(fanLastTime === null) fanLastTime = timestamp;
    const dt = Math.min(0.1, (timestamp - fanLastTime) / 1000);
    fanLastTime = timestamp;

    const rate = 1 - Math.exp(-dt / FAN_TAU);
    fanSpeed += (fanTargetSpeed - fanSpeed) * rate;

    if(fanTargetSpeed === 0 && Math.abs(fanSpeed) < 0.05){
      fanSpeed = 0;
    }

    fanAngle = (fanAngle + fanSpeed * dt) % 360;

    if(fanBladesEl && !prefersReducedMotion){
      fanBladesEl.style.transform = `rotate(${fanAngle}deg)`;
    }

    if(fanAirflowEl){
      fanAirflowEl.style.opacity = Math.min(1, fanSpeed / FAN_SPEED.danger).toFixed(2);
    }

    requestAnimationFrame(fanLoop);
  }

  requestAnimationFrame(fanLoop);

  let audioContext = null;
  let warningTimer = null;
  let dangerTimer = null;
  let audioUnlocked = false;

  function unlockAudio(){
    try{
      if(!audioContext){
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
      }
      if(audioContext.state === "suspended"){
        audioContext.resume();
      }
      audioUnlocked = true;
    } catch(error){
      console.log("Audio unavailable:", error);
    }
  }

  function playTone(frequency, duration, volume = .04, type = "sine"){
    if(!audioContext) return;
    try{
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();

      oscillator.type = type;
      oscillator.frequency.setValueAtTime(frequency, audioContext.currentTime);

      gain.gain.setValueAtTime(0, audioContext.currentTime);
      gain.gain.linearRampToValueAtTime(volume, audioContext.currentTime + .015);
      gain.gain.exponentialRampToValueAtTime(.001, audioContext.currentTime + duration);

      oscillator.connect(gain);
      gain.connect(audioContext.destination);

      oscillator.start();
      oscillator.stop(audioContext.currentTime + duration + .03);
    } catch(error){
      console.log("Tone error:", error);
    }
  }

  function startWarningSound(){
    stopAllSound();
    if(!audioUnlocked) return;

    playTone(680, .16, .055, "sine");
    warningTimer = setInterval(() => { playTone(680, .16, .055, "sine"); }, 1450);
  }

  function startDangerSound(){
    stopAllSound();
    if(!audioUnlocked) return;

    let high = false;
    function emergencyPulse(){
      high = !high;
      playTone(high ? 980 : 620, .42, .085, "sawtooth");
    }
    emergencyPulse();
    dangerTimer = setInterval(emergencyPulse, 470);
  }

  function stopAllSound(){
    if(warningTimer){ clearInterval(warningTimer); warningTimer = null; }
    if(dangerTimer){ clearInterval(dangerTimer); dangerTimer = null; }
  }

  function getLevel(){
    const danger = state.gas >= 600 || state.temp >= 45 || state.fire || state.sos;
    const warning = !danger && (state.gas >= 350 || state.temp >= 35);
    if(danger) return "danger";
    if(warning) return "warning";
    return "safe";
  }

  function updateSliderState(){
    const tempSlider = $("tempSlider");
    const gasSlider = $("gasSlider");

    tempSlider.classList.remove("safe","warning","danger");
    gasSlider.classList.remove("safe","warning","danger");

    if(state.temp >= 45) tempSlider.classList.add("danger");
    else if(state.temp >= 35) tempSlider.classList.add("warning");
    else tempSlider.classList.add("safe");

    if(state.gas >= 600) gasSlider.classList.add("danger");
    else if(state.gas >= 350) gasSlider.classList.add("warning");
    else gasSlider.classList.add("safe");
  }

  function updateSimulation(){
    const level = getLevel();
    const danger = level === "danger";
    const warning = level === "warning";
    const fanOn = danger || warning;

    let statusText = "SAFE";
    if(state.sos) statusText = "SOS! EMERGENCY";
    else if(state.fire) statusText = "DANGER! EVACUATE";
    else if(danger) statusText = "DANGER! EVACUATE";
    else if(warning) statusText = "WARNING! FAN ON";

    $("tempValue").textContent = `${state.temp.toFixed(1)}°C`;
    $("gasValue").textContent = `${state.gas} ppm`;
    $("fireValue").textContent = state.fire ? "DETECTED" : "SAFE";
    $("sosValue").textContent = state.sos ? "ACTIVE" : "READY";

    $("oledGas").textContent = `${state.gas} ppm`;
    $("oledTemp").textContent = `${state.temp.toFixed(1)} C`;
    $("oledFire").textContent = state.fire ? "DETECTED" : "SAFE";
    $("oledSos").textContent = state.sos ? "EMERGENCY" : "READY";
    $("oledStatus").textContent = `STATUS: ${statusText}`;

    const oled = $("digitalOled");
    oled.classList.remove("safe","warning","danger");
    oled.classList.add(level);

    $("oledStatus").className = `oled-status ${level}`;

    $("arduinoValue").textContent = danger ? "DANGER" : warning ? "WARNING" : "MONITORING";
    $("relayValue").textContent = fanOn ? "ON" : "OFF";
    $("fireNodeValue").textContent = state.fire ? "FIRE DETECTED" : "NO FIRE";
    $("sosNodeValue").textContent = state.sos ? "SOS ACTIVE" : "READY";
    $("fanState").textContent = fanOn ? "ON" : "OFF";

    $("arduinoNode").className = `node ${level}`;
    $("relayNode").className = `node ${fanOn ? level : ""}`;
    $("fireNode").className = `node ${state.fire ? "danger" : ""}`;
    $("sosNode").className = `node ${state.sos ? "danger" : ""}`;
    $("fanNode").className = `node fan-box ${fanOn ? "on" : ""} ${level}`;

    fanTargetSpeed = danger ? FAN_SPEED.danger : warning ? FAN_SPEED.warning : FAN_SPEED.safe;

    updateSliderState();

    stopAllSound();
    if(danger) startDangerSound();
    else if(warning) startWarningSound();
  }

  $("tempSlider").addEventListener("input", event => {
    unlockAudio();
    state.temp = Number(event.target.value);
    updateSimulation();
  });

  $("gasSlider").addEventListener("input", event => {
    unlockAudio();
    state.gas = Number(event.target.value);
    updateSimulation();
  });

  $("fireToggle").addEventListener("click", () => {
    unlockAudio();
    state.fire = !state.fire;
    $("fireToggle").classList.toggle("active", state.fire);
    $("fireToggle").textContent = state.fire ? "🔥 Flame detected — turn OFF" : "Flame not detected";
    updateSimulation();
  });

  $("sosBtn").addEventListener("click", () => {
    unlockAudio();
    state.sos = !state.sos;
    $("sosBtn").classList.toggle("active", state.sos);
    $("sosBtn").textContent = state.sos ? "CLEAR SOS EMERGENCY" : "SIMULATE SOS EMERGENCY";
    updateSimulation();
  });

  $("resetSim").addEventListener("click", () => {
    unlockAudio();
    state.temp = 29.4;
    state.gas = 212;
    state.fire = false;
    state.sos = false;

    $("tempSlider").value = state.temp;
    $("gasSlider").value = state.gas;

    $("fireToggle").classList.remove("active");
    $("fireToggle").textContent = "Flame not detected";

    $("sosBtn").classList.remove("active");
    $("sosBtn").textContent = "SIMULATE SOS EMERGENCY";

    stopAllSound();
    updateSimulation();
  });

  updateSimulation();
})();
</script>

