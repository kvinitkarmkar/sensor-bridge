<script>
(async () => {

  const API =
    "https://api.counterapi.dev/v2/dgms-buddys-team-5509/first-counter-5509";

  const SESSION_KEY = "ums_visitor_counted";

  const visitorCount =
    document.getElementById("visitorCount");

  try {

    // Check whether this browser session
    // has already been counted
    const alreadyCounted =
      sessionStorage.getItem(SESSION_KEY) === "true";

    let response;

    if (!alreadyCounted) {

      // FIRST ENTRY → increase counter
      response = await fetch(API, {
        method: "POST",
        cache: "no-store"
      });

      if (!response.ok) {
        throw new Error("Counter increment failed");
      }

      // Mark this session as counted
      sessionStorage.setItem(
        SESSION_KEY,
        "true"
      );

    } else {

      // REFRESH → don't increase
      response = await fetch(API, {
        method: "GET",
        cache: "no-store"
      });

      if (!response.ok) {
        throw new Error("Counter fetch failed");
      }
    }

    const result = await response.json();

    const count =
      result.data?.up_count ?? 0;

    visitorCount.textContent =
      Number(count).toLocaleString("en-IN");

  } catch (error) {

    console.error(
      "Visitor counter error:",
      error
    );

    visitorCount.textContent = "—";
  }

})();
</script>
  
